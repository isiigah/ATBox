<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AT Macintosh Remake WebOS</title>
    <style>
        /* 1990 Macintosh Pattern Styles */
        :root {
            --bg-pattern: radial-gradient(#666 25%, transparent 25%), radial-gradient(#666 25%, transparent 25%);
            --bg-size: 4px 4px;
            --bg-position: 0 0, 2px 2px;
        }

        * {
            box-sizing: border-box;
            user-select: none;
        }

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            font-family: "Geneva", "Chicago", "Courier New", monospace;
            font-size: 11px; font-weight: bold;
            background-color: #999;
            background-image: var(--bg-pattern);
            background-size: var(--bg-size);
            background-position: var(--bg-position);
            overflow: hidden; color: #000;
        }

        /* --- ADVANCED TEXT BOOT SEQUENCE --- */
        #boot-screen {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: #fff; z-index: 999999;
            display: flex; flex-direction: column;
            justify-content: center; align-items: center;
        }

        #boot-mac-box {
            border: 4px solid #000; padding: 12px 18px; font-size: 24px;
            background: #fff; font-family: monospace; margin-bottom: 25px;
            box-shadow: 4px 4px 0 #000; text-align: center; line-height: 1;
        }

        #boot-log {
            width: 320px; height: 110px; border: 1px dashed #000;
            background: #fff; font-family: "Courier New", monospace;
            font-size: 11px; padding: 8px; overflow: hidden;
            white-space: pre-line; line-height: 1.4;
        }

        /* --- INTERFACE MANAGEMENT SYSTEM --- */
        #menu-bar {
            background-color: #fff; border-bottom: 2px solid #000;
            height: 24px; display: flex; align-items: center; padding: 0 10px;
            position: absolute; top: 0; left: 0; width: 100%; z-index: 9999;
        }

        .menu-item { position: relative; padding: 2px 10px; cursor: pointer; }
        .menu-item:hover, .menu-item.active { background-color: #000; color: #fff; }
        
        .dropdown {
            display: none; position: absolute; top: 22px; left: 0;
            background-color: #fff; border: 2px solid #000;
            box-shadow: 3px 3px 0px #000; min-width: 200px; max-height: 400px; overflow-y: auto; z-index: 10000;
        }
        .menu-item.active .dropdown { display: block; }
        
        .dropdown-item { padding: 5px 12px; color: #000; background: #fff; }
        .dropdown-item:hover { background-color: #000; color: #fff; }

        #desktop {
            position: absolute; top: 24px; left: 0; right: 0; bottom: 0;
            padding: 20px; display: flex; flex-direction: column;
            flex-wrap: wrap; gap: 12px; align-content: flex-start;
        }

        .desk-icon { width: 85px; text-align: center; cursor: pointer; margin-bottom: 4px; }
        .desk-icon .icon-box {
            width: 40px; height: 40px; border: 2px solid #000; background-color: #fff;
            margin: 0 auto 4px auto; display: flex; align-items: center; justify-content: center;
            font-size: 20px; box-shadow: 2px 2px 0 #000;
        }
        .desk-icon:active .icon-box { background-color: #000; color: #fff; }
        .desk-icon .icon-label { background-color: #fff; border: 1px solid #000; padding: 1px 4px; font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;}

        /* --- WINDOW ARCHITECTURE --- */
        .window {
            position: absolute; background-color: #fff; border: 2px solid #000;
            box-shadow: 4px 4px 0px #000; display: flex; flex-direction: column;
            min-width: 240px; min-height: 150px;
        }

        .title-bar {
            background: repeating-linear-gradient(0deg, #000, #000 1px, #fff 1px, #fff 3px);
            border-bottom: 2px solid #000; height: 22px;
            display: flex; align-items: center; justify-content: space-between; padding: 0 6px; cursor: move;
        }

        .title-text { background-color: #fff; padding: 0 8px; color: #000; font-size: 11px; }
        .close-box { width: 12px; height: 12px; border: 1px solid #000; background-color: #fff; cursor: pointer; }
        .close-box:active { background-color: #000; }
        .window-content { padding: 10px; flex: 1; overflow: auto; background-color: #fff; }

        .mac-btn {
            background: #fff; border: 1px solid #000; padding: 4px 8px;
            cursor: pointer; display: inline-block; box-shadow: 1px 1px 0 #000;
            font-weight: bold; font-family: inherit; font-size: 10px; margin: 2px;
        }
        .mac-btn:active { background: #000; color: #fff; }

        /* --- APP CONTENT SPECS --- */
        .launchpad-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }
        .launch-item { border: 1px solid #000; padding: 6px 2px; background: #fff; cursor: pointer; box-shadow: 2px 2px 0 #000; font-size: 10px; }
        .launch-item:active { background: #000; color: #fff; }
        .launch-icon { font-size: 18px; margin-bottom: 2px; }

        .term-box { background: #fff; border: 1px solid #000; height: 120px; font-family: monospace; overflow-y: auto; padding: 4px; }
        .term-out { white-space: pre-wrap; font-size: 11px; }
        .term-row { display: flex; align-items: center; margin-top: 4px; }
        .term-input { flex: 1; border: none; outline: none; font-family: monospace; font-size: 11px; font-weight: bold; }

        .file-row { display: flex; align-items: center; padding: 5px; border-bottom: 1px dashed #000; cursor: pointer; }
        .file-row:hover { background-color: #000; color: #fff; }
        textarea.mac-editor { width: 100%; height: 110px; border: 1px solid #000; resize: none; font-family: monospace; outline: none; padding: 4px; }
        
        /* Fixed MacPaint Canvas styles */
        .paint-canvas { border: 1px solid #000; background: #fff; cursor: crosshair; display: block; touch-action: none; }
        
        .calc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; }
        .calc-screen { border: 2px solid #000; text-align: right; padding: 4px; font-family: monospace; font-size: 13px; margin-bottom: 6px; }
        
        .game-canvas { border: 2px solid #000; background: #fff; display: block; margin: 0 auto; }
        .bar-container { border: 1px solid #000; background: #fff; height: 14px; margin: 6px 0; position: relative; }
        .bar-fill { background: #000; height: 100%; width: 0%; transition: width 0.3s; }

        /* Memory game layout */
        .memory-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px; width: 160px; margin: 0 auto; }
        .memory-card { width: 36px; height: 36px; border: 1px solid #000; display: flex; align-items: center; justify-content: center; background: #fff; cursor: pointer; font-size: 16px; }
        .memory-card.flipped { background: #eee; }

        /* Todo checklist styles */
        .todo-item { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
    </style>
</head>
